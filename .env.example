# Environment variables for LegalMind-AI
# Copy this file to .env and fill in your values

# OpenAI API key (leave blank to use demo mode)
OPENAI_API_KEY=

# OpenAI model to use
OPENAI_MODEL=gpt-3.5-turbo

# Set to False to use live OpenAI calls (requires OPENAI_API_KEY)
DEMO_MODE=True

# Maximum document upload size in MB
MAX_DOCUMENT_SIZE_MB=10
